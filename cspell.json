{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "description": "CSpell configuration for Life OS monorepo - Personal productivity system",

  "dictionaryDefinitions": [
    {
      "name": "project-terms",
      "path": "./.cspell/project-terms.txt",
      "addWords": true,
      "description": "Life OS domain-specific terminology"
    },
    {
      "name": "technical-terms",
      "path": "./.cspell/technical-terms.txt",
      "addWords": true,
      "description": "Technical and architecture terminology"
    },
    {
      "name": "company-names",
      "path": "./.cspell/company-names.txt",
      "addWords": true,
      "description": "Company and product names"
    }
  ],

  "dictionaries": ["project-terms", "technical-terms", "company-names", "typescript", "node", "softwareTerms", "en_US"],

  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/out/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.git/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/*.lock",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.svg",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.ico",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.eot",
    "**/*.mp4",
    "**/*.webm",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar.gz",
    "**/.cspell/**",
    "**/supabase/.temp/**"
  ],

  "files": ["**/*.{md,mdx,txt}", "**/*.{ts,tsx,js,jsx}", "**/*.{json,yaml,yml}", "**/*.{sql}"],

  "ignoreRegExpList": [
    "https?://[^\\s]+",
    "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b",
    "\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b",
    "^[A-Za-z0-9+/]{20,}={0,2}$",
    "[a-zA-Z]:\\\\[^\\s]*",
    "#[0-9a-fA-F]{3,8}",
    "\\${[A-Z_][A-Z0-9_]*}",
    "import\\s+.*from\\s+['\"].*['\"]",
    "\\b[A-Z][a-zA-Z]*\\.[a-z][a-zA-Z]*\\b",
    ":\\s*[A-Z][a-zA-Z<>\\[\\],\\s]*",
    "\\b[a-z_]+\\.[a-z_]+\\b"
  ],

  "languageSettings": [
    {
      "languageId": "typescript,javascript,tsx,jsx",
      "locale": "*",
      "dictionaries": ["typescript", "node", "softwareTerms"],
      "ignoreRegExpList": ["\\b[A-Z][a-z]+[A-Z][a-z]+\\b", "\\b[a-z]+[A-Z][a-z]+\\b"]
    },
    {
      "languageId": "markdown,mdx",
      "locale": "*",
      "minWordLength": 4,
      "allowCompoundWords": true
    },
    {
      "languageId": "sql",
      "locale": "*",
      "dictionaries": ["softwareTerms"],
      "ignoreRegExpList": [
        "\\b(SELECT|FROM|WHERE|JOIN|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|TABLE|INDEX|VIEW|TRIGGER|FUNCTION|PROCEDURE)\\b",
        "\\b[VARCHAR|INTEGER|TEXT|BOOLEAN|TIMESTAMP|UUID|JSONB|SERIAL)\\b"
      ]
    },
    {
      "languageId": "json,jsonc",
      "locale": "*",
      "minWordLength": 4
    }
  ],

  "overrides": [
    {
      "filename": "**/*.test.{ts,tsx,js,jsx}",
      "minWordLength": 3,
      "allowCompoundWords": true
    },
    {
      "filename": "**/*.spec.{ts,tsx,js,jsx}",
      "minWordLength": 3,
      "allowCompoundWords": true
    },
    {
      "filename": "**/{.planning,docs}/**",
      "minWordLength": 4,
      "allowCompoundWords": true
    },
    {
      "filename": "**/migrations/*.sql",
      "languageId": "sql"
    }
  ],

  "features": {
    "allowCompoundWords": false,
    "caseSensitive": false
  },

  "minWordLength": 4,
  "maxNumberOfProblems": 100,

  "words": [],
  "flagWords": ["hte", "teh", "recieve", "occured", "seperate", "definately", "goverment", "occassionally", "untill", "wich", "thier"],

  "ignoreWords": []
}
